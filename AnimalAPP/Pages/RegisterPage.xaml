<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AnimalAPP.Pages.RegisterPage"
             Title="Registro de Usuario">
    
    <StackLayout Padding="20">
        <Entry Placeholder="Nombre" x:Name="NombreEntry" />
        <Entry Placeholder="Correo electrónico" x:Name="EmailEntry" />
        <Entry Placeholder="Contraseña" IsPassword="True" x:Name="PasswordEntry" />
        <Picker Title="Rol" x:Name="RolPicker">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Usuario estándar</x:String>
                    <x:String>Admin</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
        <Button Text="Registrar" Clicked="OnRegisterClicked" />
    </StackLayout>
    
</ContentPage>