<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AnimalAPP.Pages.LoginPage"
             Title="Inicio de Sesión">

    <StackLayout Padding="20">
        <Entry Placeholder="Correo electrónico" x:Name="EmailEntry" />
        <Entry Placeholder="Contraseña" IsPassword="True" x:Name="PasswordEntry" />
        <Button Text="Iniciar Sesión" Clicked="OnLoginClicked" />
        <Button Text="Registrarse" Clicked="OnRegisterClicked" />
    </StackLayout>
</ContentPage>