<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AnimalAPP.Pages.CitaPage"
             Title="Gestión de Citas">

    <StackLayout Padding="20">
        <DatePicker x:Name="FechaPicker" />
        <TimePicker x:Name="HoraPicker" />
        <Entry Placeholder="Nombre de la Mascota" x:Name="MascotaEntry" />
        <Entry Placeholder="Motivo de la Cita" x:Name="MotivoEntry" />
        <!--<Button Text="Crear Cita" Clicked="OnCrearCitaClicked" />-->
        <ListView x:Name="CitasListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Mascota}" Detail="{Binding Motivo}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>

</ContentPage>